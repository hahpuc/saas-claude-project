{
  "name": "saas-project",
  "version": "0.1.0",
  "private": true,
  "description": "Modern SaaS application with NestJS API and React Admin",
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/admin"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "bash .claude/scripts/build.sh",
    "test": "bash .claude/scripts/test.sh",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,json,css,md}\"",
    "setup": "bash .claude/scripts/setup.sh"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
